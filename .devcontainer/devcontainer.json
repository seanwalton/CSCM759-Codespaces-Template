{
  "name": "CSCM759 Axolotl Adventures",

  // PHP 8.4 on Debian bookworm. Laravel 13 supports PHP 8.3-8.5.
  // To move the whole module to a different PHP version, change this ONE line.
  "image": "mcr.microsoft.com/devcontainers/php:4-8.4-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // 8000 = php artisan serve, 5173 = Vite dev server
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": {
      "label": "Axolotl Adventures",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Vite",
      "onAutoForward": "silent"
    }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "laravel.vscode-laravel",
        "bmewburn.vscode-intelephense-client",
        "qwtel.sqlite-viewer",
        "EditorConfig.EditorConfig"
      ],
      "settings": {
        "files.eol": "\n",
        "editor.tabSize": 4,
        "emmet.includeLanguages": {
          "blade": "html"
        },
        "[blade]": {
          "editor.autoClosingBrackets": "always"
        }
      }
    }
  },

  "remoteUser": "vscode"
}
